<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Page title will be dynamic based on the current View -->
    <title>@ViewData["Title"] - Majlis2Go</title>

    <!-- ✅ Bootstrap CSS: keep it in <head> so styling loads before content renders -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- ✅ Your site-wide custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- ✅ Auto-generated project styles (e.g., from scaffolding) -->
    <link rel="stylesheet" href="~/Majlis2Go.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- ================= HEADER (Navigation Bar) ================= -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Brand / Logo -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Majlis2Go</a>

                <!-- Hamburger menu button (for mobile view) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation links -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <!-- ✅ Example extra link for Events -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ================= MAIN CONTENT AREA ================= -->
    <div class="container">
        <main role="main" class="pb-3">
            <!-- ✅ Each View will be injected here -->
            @RenderBody()
        </main>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="border-top footer text-muted mt-4">
        <div class="container text-center">
            &copy; 2025 - Majlis2Go |
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- ================= JAVASCRIPT FILES ================= -->
    <!-- ✅ jQuery (some Bootstrap plugins need it, though Bootstrap 5 no longer depends on it strictly) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- ✅ Bootstrap JS bundle (includes Popper.js for tooltips/dropdowns) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ✅ Your custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ✅ Extra per-page scripts (optional section) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
