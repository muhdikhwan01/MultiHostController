@model EventInvitationApp.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-3">
        <div class="card-header bg-primary text-white text-center">
            <h2 class="mb-0">@Model.Title</h2>
        </div>
        <div class="card-body">
            <p class="lead">@Model.Description</p>

            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>📅 Date:</strong> @Model.Date.ToString("dddd, dd MMMM yyyy")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>📍 Location:</strong> @Model.Location</p>
                </div>
            </div>

            <p><strong>👤 Hosted by:</strong> @Model.HostName</p>

            <hr />

            <!-- RSVP Form -->
            <h4 class="mt-4">RSVP</h4>
            <form asp-action="Create" asp-controller="RSVPs" method="post" class="mt-3">
                <!-- ✅ Hidden EventId field -->
                <input type="hidden" name="EventId" value="@Model.EventId" />

                <div class="mb-3">
                    <label for="GuestName" class="form-label">Your Name</label>
                    <!-- ✅ Must match RSVP.GuestName -->
                    <input type="text" name="GuestName" class="form-control" placeholder="Enter your name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Will you attend?</label><br />
                    <!-- ✅ Must match RSVP.IsAttending -->
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsAttending" value="true" required />
                        <label class="form-check-label">Yes 🎉</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="IsAttending" value="false" />
                        <label class="form-check-label">No 😢</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-success">Submit RSVP</button>
            </form>

            <hr />

            <!-- Guest Lists -->
            <h4 class="mt-4">Guest List</h4>

            <div class="row">
                <!-- Attending -->
                <div class="col-md-6">
                    <h5>🎉 Attending (@Model.RSVPs.Count(r => r.IsAttending == true))</h5>
                    @if (Model.RSVPs.Any(r => r.IsAttending == true))
                    {
                        <ul class="list-group">
                            @foreach (var rsvp in Model.RSVPs.Where(r => r.IsAttending == true))
                            {
                                <li class="list-group-item">@rsvp.GuestName</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No one has RSVP’d "Yes" yet.</p>
                    }
                </div>

                <!-- Not Attending -->
                <div class="col-md-6">
                    <h5>😢 Not Attending (@Model.RSVPs.Count(r => r.IsAttending == false))</h5>
                    @if (Model.RSVPs.Any(r => r.IsAttending == false))
                    {
                        <ul class="list-group">
                            @foreach (var rsvp in Model.RSVPs.Where(r => r.IsAttending == false))
                            {
                                <li class="list-group-item">@rsvp.GuestName</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted">No one has declined yet.</p>
                    }
                </div>
            </div>

            <div class="mt-4">
                <a asp-action="Index" class="btn btn-secondary">← Back to Events</a>
            </div>
        </div>
    </div>
</div>
